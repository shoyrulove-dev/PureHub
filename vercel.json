{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd pwa && npm install && cd .. && python3 -m pip install --break-system-packages -r requirements.txt",
  "buildCommand": "cd pwa && npm run build",
  "outputDirectory": "pwa/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/public-api/support-sync",
      "schedule": "*/10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/public-api/:path*",
      "destination": "/api/index?__purehub_path=/public-api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index?__purehub_path=/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
